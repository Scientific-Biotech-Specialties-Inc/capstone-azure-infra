{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.49.2.45890",
      "templateHash": "10229781128301462291"
    }
  },
  "parameters": {
    "location": {
      "type": "string",
      "metadata": {
        "description": "Region — must match the Managed Environment region."
      }
    },
    "managedEnvironmentId": {
      "type": "string",
      "metadata": {
        "description": "Managed Environment ID."
      }
    },
    "minReplicas": {
      "type": "int",
      "defaultValue": 1,
      "metadata": {
        "description": "Minimum replicas. 1 = always running, 0 = scale to zero."
      }
    },
    "mysqlRootPassword": {
      "type": "securestring"
    },
    "postgresPassword": {
      "type": "securestring"
    },
    "registryServer": {
      "type": "string",
      "defaultValue": ""
    },
    "registryUser": {
      "type": "string",
      "defaultValue": ""
    },
    "registryPassword": {
      "type": "securestring",
      "defaultValue": ""
    },
    "mysqlImage": {
      "type": "string",
      "defaultValue": "docker.io/library/mysql:8.0"
    },
    "redisImage": {
      "type": "string",
      "defaultValue": "docker.io/library/redis:7-alpine"
    },
    "postgresImage": {
      "type": "string",
      "defaultValue": "docker.io/pgvector/pgvector:pg16"
    },
    "mongoImage": {
      "type": "string",
      "defaultValue": "docker.io/library/mongo:7"
    }
  },
  "variables": {
    "hasRegistry": "[and(not(empty(parameters('registryServer'))), not(empty(parameters('registryUser'))))]",
    "registryConfig": "[if(variables('hasRegistry'), createArray(createObject('server', parameters('registryServer'), 'username', parameters('registryUser'), 'passwordSecretRef', 'reg-pass')), createArray())]",
    "registrySecret": "[if(variables('hasRegistry'), createArray(createObject('name', 'reg-pass', 'value', parameters('registryPassword'))), createArray())]"
  },
  "resources": [
    {
      "type": "Microsoft.App/containerApps",
      "apiVersion": "2024-03-01",
      "name": "shared-mysql",
      "location": "[parameters('location')]",
      "properties": {
        "managedEnvironmentId": "[parameters('managedEnvironmentId')]",
        "configuration": {
          "activeRevisionsMode": "Single",
          "ingress": {
            "external": false,
            "targetPort": 3306,
            "transport": "tcp",
            "exposedPort": 3306
          },
          "registries": "[variables('registryConfig')]",
          "secrets": "[concat(createArray(createObject('name', 'root-password', 'value', parameters('mysqlRootPassword'))), variables('registrySecret'))]"
        },
        "template": {
          "containers": [
            {
              "name": "shared-mysql",
              "image": "[parameters('mysqlImage')]",
              "resources": {
                "cpu": "[json('0.5')]",
                "memory": "1.0Gi"
              },
              "env": [
                {
                  "name": "MYSQL_ROOT_PASSWORD",
                  "secretRef": "root-password"
                },
                {
                  "name": "MYSQL_DATABASE",
                  "value": "serms"
                },
                {
                  "name": "MYSQL_USER",
                  "value": "serms_user"
                },
                {
                  "name": "MYSQL_PASSWORD",
                  "secretRef": "root-password"
                }
              ]
            }
          ],
          "scale": {
            "minReplicas": "[parameters('minReplicas')]",
            "maxReplicas": 1
          }
        }
      }
    },
    {
      "type": "Microsoft.App/containerApps",
      "apiVersion": "2024-03-01",
      "name": "shared-redis",
      "location": "[parameters('location')]",
      "properties": {
        "managedEnvironmentId": "[parameters('managedEnvironmentId')]",
        "configuration": {
          "activeRevisionsMode": "Single",
          "ingress": {
            "external": false,
            "targetPort": 6379,
            "transport": "tcp",
            "exposedPort": 6379
          }
        },
        "template": {
          "containers": [
            {
              "name": "shared-redis",
              "image": "[parameters('redisImage')]",
              "resources": {
                "cpu": "[json('0.25')]",
                "memory": "0.5Gi"
              }
            }
          ],
          "scale": {
            "minReplicas": "[parameters('minReplicas')]",
            "maxReplicas": 1
          }
        }
      }
    },
    {
      "type": "Microsoft.App/containerApps",
      "apiVersion": "2024-03-01",
      "name": "shared-postgres",
      "location": "[parameters('location')]",
      "properties": {
        "managedEnvironmentId": "[parameters('managedEnvironmentId')]",
        "configuration": {
          "activeRevisionsMode": "Single",
          "ingress": {
            "external": false,
            "targetPort": 5432,
            "transport": "tcp",
            "exposedPort": 5432
          },
          "secrets": [
            {
              "name": "pg-password",
              "value": "[parameters('postgresPassword')]"
            }
          ]
        },
        "template": {
          "containers": [
            {
              "name": "shared-postgres",
              "image": "[parameters('postgresImage')]",
              "resources": {
                "cpu": "[json('0.5')]",
                "memory": "1.0Gi"
              },
              "env": [
                {
                  "name": "POSTGRES_USER",
                  "value": "ocr_user"
                },
                {
                  "name": "POSTGRES_PASSWORD",
                  "secretRef": "pg-password"
                },
                {
                  "name": "POSTGRES_DB",
                  "value": "ocr_pipeline"
                }
              ]
            }
          ],
          "scale": {
            "minReplicas": "[parameters('minReplicas')]",
            "maxReplicas": 1
          }
        }
      }
    },
    {
      "type": "Microsoft.App/containerApps",
      "apiVersion": "2024-03-01",
      "name": "shared-mongo",
      "location": "[parameters('location')]",
      "properties": {
        "managedEnvironmentId": "[parameters('managedEnvironmentId')]",
        "configuration": {
          "activeRevisionsMode": "Single",
          "ingress": {
            "transport": "tcp",
            "targetPort": 27017,
            "exposedPort": 27017,
            "external": false
          }
        },
        "template": {
          "containers": [
            {
              "name": "shared-mongo",
              "image": "[parameters('mongoImage')]",
              "resources": {
                "cpu": "[json('0.5')]",
                "memory": "1.0Gi"
              }
            }
          ],
          "scale": {
            "minReplicas": "[parameters('minReplicas')]",
            "maxReplicas": 1
          }
        }
      }
    }
  ],
  "outputs": {
    "mysqlFqdn": {
      "type": "string",
      "value": "shared-mysql"
    },
    "redisFqdn": {
      "type": "string",
      "value": "shared-redis"
    },
    "postgresFqdn": {
      "type": "string",
      "value": "shared-postgres"
    },
    "mongoFqdn": {
      "type": "string",
      "value": "shared-mongo"
    }
  }
}