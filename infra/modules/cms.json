{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.46.1.21595",
      "templateHash": "9983452753131613640"
    }
  },
  "parameters": {
    "location": {
      "type": "string",
      "metadata": {
        "description": "Region — must match the Managed Environment region."
      }
    },
    "managedEnvironmentId": {
      "type": "string",
      "metadata": {
        "description": "Managed Environment ID."
      }
    },
    "minReplicas": {
      "type": "int",
      "defaultValue": 0,
      "metadata": {
        "description": "Minimum replicas. 0 = serverless scale-to-zero, 1 = warm."
      }
    },
    "registryServer": {
      "type": "string",
      "defaultValue": ""
    },
    "registryUser": {
      "type": "string",
      "defaultValue": ""
    },
    "registryPassword": {
      "type": "securestring",
      "defaultValue": ""
    },
    "cmsWebImage": {
      "type": "string",
      "defaultValue": "docker.io/library/nginx:alpine"
    },
    "cmsBackendImage": {
      "type": "string",
      "defaultValue": "docker.io/library/nginx:alpine"
    },
    "mysqlPassword": {
      "type": "securestring",
      "defaultValue": ""
    },
    "jwtSecret": {
      "type": "securestring",
      "defaultValue": ""
    },
    "internalEncryptionKey": {
      "type": "securestring",
      "defaultValue": ""
    },
    "mysqlHost": {
      "type": "string",
      "defaultValue": ""
    },
    "redisHost": {
      "type": "string",
      "defaultValue": ""
    },
    "authServiceUrl": {
      "type": "string",
      "defaultValue": ""
    }
  },
  "variables": {
    "hasRegistry": "[and(not(empty(parameters('registryServer'))), not(empty(parameters('registryUser'))))]",
    "registryConfig": "[if(variables('hasRegistry'), createArray(createObject('server', parameters('registryServer'), 'username', parameters('registryUser'), 'passwordSecretRef', 'reg-pass')), createArray())]",
    "registrySecret": "[if(variables('hasRegistry'), createArray(createObject('name', 'reg-pass', 'value', parameters('registryPassword'))), createArray())]",
    "cmsServices": [
      "vendor-management",
      "contract-management",
      "search",
      "notification",
      "ai-service",
      "analytics-service"
    ]
  },
  "resources": [
    {
      "type": "Microsoft.App/containerApps",
      "apiVersion": "2024-03-01",
      "name": "cms-web",
      "location": "[parameters('location')]",
      "properties": {
        "managedEnvironmentId": "[parameters('managedEnvironmentId')]",
        "configuration": {
          "activeRevisionsMode": "Single",
          "ingress": {
            "external": true,
            "targetPort": 5001,
            "transport": "http",
            "allowInsecure": true
          },
          "registries": "[variables('registryConfig')]",
          "secrets": "[variables('registrySecret')]"
        },
        "template": {
          "containers": [
            {
              "name": "cms-web",
              "image": "[parameters('cmsWebImage')]",
              "resources": {
                "cpu": "[json('0.25')]",
                "memory": "0.5Gi"
              }
            }
          ],
          "scale": {
            "minReplicas": "[parameters('minReplicas')]",
            "maxReplicas": 2,
            "rules": [
              {
                "name": "http-scaler",
                "http": {
                  "metadata": {
                    "concurrentRequests": "20"
                  }
                }
              }
            ]
          }
        }
      }
    },
    {
      "copy": {
        "name": "cmsMicroservices",
        "count": "[length(variables('cmsServices'))]"
      },
      "type": "Microsoft.App/containerApps",
      "apiVersion": "2024-03-01",
      "name": "[variables('cmsServices')[copyIndex()]]",
      "location": "[parameters('location')]",
      "properties": {
        "managedEnvironmentId": "[parameters('managedEnvironmentId')]",
        "configuration": {
          "activeRevisionsMode": "Single",
          "ingress": {
            "external": true,
            "targetPort": 8000,
            "transport": "http",
            "allowInsecure": true
          },
          "registries": "[variables('registryConfig')]",
          "secrets": "[concat(variables('registrySecret'), createArray(createObject('name', 'db-password', 'value', parameters('mysqlPassword')), createObject('name', 'jwt-secret', 'value', parameters('jwtSecret')), createObject('name', 'encryption-key', 'value', parameters('internalEncryptionKey'))))]"
        },
        "template": {
          "containers": [
            {
              "name": "[variables('cmsServices')[copyIndex()]]",
              "image": "[parameters('cmsBackendImage')]",
              "resources": {
                "cpu": "[json('0.25')]",
                "memory": "0.5Gi"
              },
              "env": [
                {
                  "name": "APP_ENV",
                  "value": "production"
                },
                {
                  "name": "SERVICE_NAME",
                  "value": "[variables('cmsServices')[copyIndex()]]"
                },
                {
                  "name": "DB_HOST",
                  "value": "[parameters('mysqlHost')]"
                },
                {
                  "name": "DB_DATABASE",
                  "value": "[format('cms_{0}', replace(variables('cmsServices')[copyIndex()], '-', '_'))]"
                },
                {
                  "name": "DB_PASSWORD",
                  "secretRef": "db-password"
                },
                {
                  "name": "REDIS_HOST",
                  "value": "[parameters('redisHost')]"
                },
                {
                  "name": "AUTH_SERVICE_URL",
                  "value": "[parameters('authServiceUrl')]"
                },
                {
                  "name": "JWT_SECRET",
                  "secretRef": "jwt-secret"
                },
                {
                  "name": "INTERNAL_ENCRYPTION_KEY",
                  "secretRef": "encryption-key"
                }
              ]
            }
          ],
          "scale": {
            "minReplicas": "[parameters('minReplicas')]",
            "maxReplicas": 1,
            "rules": [
              {
                "name": "http-scaler",
                "http": {
                  "metadata": {
                    "concurrentRequests": "15"
                  }
                }
              }
            ]
          }
        }
      }
    }
  ],
  "outputs": {
    "cmsWebFqdn": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.App/containerApps', 'cms-web'), '2024-03-01').configuration.ingress.fqdn]"
    },
    "vendorManagementFqdn": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.App/containerApps', variables('cmsServices')[0]), '2024-03-01').configuration.ingress.fqdn]"
    },
    "contractManagementFqdn": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.App/containerApps', variables('cmsServices')[1]), '2024-03-01').configuration.ingress.fqdn]"
    },
    "searchFqdn": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.App/containerApps', variables('cmsServices')[2]), '2024-03-01').configuration.ingress.fqdn]"
    },
    "notificationFqdn": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.App/containerApps', variables('cmsServices')[3]), '2024-03-01').configuration.ingress.fqdn]"
    },
    "aiServiceFqdn": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.App/containerApps', variables('cmsServices')[4]), '2024-03-01').configuration.ingress.fqdn]"
    },
    "analyticsServiceFqdn": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.App/containerApps', variables('cmsServices')[5]), '2024-03-01').configuration.ingress.fqdn]"
    }
  }
}