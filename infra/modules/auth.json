                },
                {
                  "name": "DB_HOST",
                  "value": "[parameters('mysqlHost')]"
                },
                {
                  "name": "DB_DATABASE",
                  "value": "capstone_auth"
                },
                {
                  "name": "DB_USERNAME",
                  "value": "root"
