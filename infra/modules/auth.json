          "secrets": "[concat(variables('registrySecret'), createArray(createObject('name', 'app-key', 'value', parameters('authAppKey')), createObject('name', 'db-password', 'value', parameters('mysqlPassword')), createObject('name', 'encryption-key', 'value', parameters('internalEncryptionKey')), createObject('name', 'mail-password', 'value', parameters('mailPassword')), createObject('name', 'brevo-key', 'value', parameters('brevoApiKey'))))]"
