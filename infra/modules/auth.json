          "registries": "[variables('registryConfig')]",
          "secrets": "[concat(variables('registrySecret'), createArray(createObject('name', 'app-key', 'value', parameters('authAppKey')), createObject('name', 'db-password', 'value', parameters('mysqlPassword')), createObject('name', 'encryption-key', 'value', parameters('internalEncryptionKey')), createObject('name', 'internal-secret', 'value', parameters('internalEncryptionKey')), createObject('name', 'mail-password', 'value', parameters('mailPassword')), createObject('name', 'brevo-key', 'value', parameters('brevoApiKey'))))]"
        },
        "template": {
          "containers": [
            {
              "name": "auth-api",
              "image": "[parameters('authApiImage')]",
              "resources": {
                "cpu": "[json('0.5')]",
                "memory": "1.0Gi"
              },
              "env": [
                {
