          "registries": "[variables('registryConfig')]",
          "secrets": "[concat(variables('registrySecret'), createArray(createObject('name', 'app-key', 'value', parameters('sermsAppKey')), createObject('name', 'db-password', 'value', parameters('mysqlPassword')), createObject('name', 'jwt-secret', 'value', parameters('jwtSecret')), createObject('name', 'ai-api-key', 'value', parameters('aiServiceApiKey')), createObject('name', 'supabase-key', 'value', parameters('supabaseAccessKey')), createObject('name', 'supabase-secret', 'value', parameters('supabaseSecretKey'))))]"
        },
        "template": {
          "containers": [
            {
              "name": "serms-worker",
              "image": "[parameters('sermsApiImage')]",
              "command": [
                "php"
              ],
              "args": [
                "artisan",
                "queue:work",
                "--sleep=3",
                "--tries=3"
